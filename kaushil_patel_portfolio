    ====================================================================== -->
    <div id="toast" role="status" aria-live="polite"
        class="fixed bottom-5 right-5 z-50 translate-y-20 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-navy-950 shadow-lg font-medium text-sm">
        <svg class="w-4 h-4 text-accent-teal dark:text-teal-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        <span id="toast-message">Copied to clipboard!</span>
