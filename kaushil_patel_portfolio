    <!-- =====================================================================
         JAVASCRIPT INTERACTIVITY
    ====================================================================== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Set dynamic copyright year
            const yearEl = document.getElementById('current-year');
            if (yearEl) {
                yearEl.textContent = new Date().getFullYear();
            }

            // -----------------------------------------------------------------
            // 1. Toast Notification Helper
            // -----------------------------------------------------------------
            let toastTimer = null;
            function showToast(message) {
                const toast = document.getElementById('toast');
                const toastMsg = document.getElementById('toast-message');
                if (!toast || !toastMsg) return;

                toastMsg.textContent = message;
                toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
                toast.classList.add('translate-y-0', 'opacity-100');

                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => {
                    toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
                    toast.classList.remove('translate-y-0', 'opacity-100');
                }, 2800);
            }

            // -----------------------------------------------------------------
            // 2. Reliable Clipboard Copy Helper (iFrame-safe)
            // -----------------------------------------------------------------
            function copyTextToClipboard(text, successMessage) {
                try {
                    const tempTextArea = document.createElement('textarea');
                    tempTextArea.value = text;
                    tempTextArea.setAttribute('readonly', '');
                    tempTextArea.style.position = 'fixed';
                    tempTextArea.style.left = '-9999px';
                    document.body.appendChild(tempTextArea);
                    tempTextArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(tempTextArea);
                    showToast(successMessage);
                } catch (err) {
                    showToast('Unable to copy automatically. Please copy manually.');
                }
            }

            // -----------------------------------------------------------------
            // 3. Light / Dark Theme Toggle
            // -----------------------------------------------------------------
            function toggleTheme() {
                const html = document.documentElement;
                const isDark = html.classList.toggle('dark');
                try {
                    localStorage.setItem('kp-portfolio-theme', isDark ? 'dark' : 'light');
                } catch (err) {
                    // Ignore storage restrictions
                }
            }

            const themeBtn = document.getElementById('theme-toggle');
            const themeBtnMobile = document.getElementById('theme-toggle-mobile');
            if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
            if (themeBtnMobile) themeBtnMobile.addEventListener('click', toggleTheme);

            // -----------------------------------------------------------------
            // 4. Mobile Hamburger Menu
            // -----------------------------------------------------------------
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuIconOpen = document.getElementById('menu-icon-open');
            const menuIconClose = document.getElementById('menu-icon-close');
            const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

            function setMobileMenuState(isOpen) {
                if (!mobileMenu || !mobileMenuBtn) return;
                mobileMenu.classList.toggle('hidden', !isOpen);
                menuIconOpen.classList.toggle('hidden', isOpen);
                menuIconClose.classList.toggle('hidden', !isOpen);
                mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', () => {
                    const isCurrentlyHidden = mobileMenu.classList.contains('hidden');
                    setMobileMenuState(isCurrentlyHidden);
                });
            }

            mobileNavLinks.forEach(link => {
                link.addEventListener('click', () => setMobileMenuState(false));
            });

            // -----------------------------------------------------------------
            // 5. Project Category Filtering
            // -----------------------------------------------------------------
            const filterBtns = document.querySelectorAll('.filter-btn');
            const projectCards = document.querySelectorAll('.project-card');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const selected = btn.getAttribute('data-filter');

                    // Update active button styles
                    filterBtns.forEach(b => {
                        b.classList.remove('bg-sky-600', 'text-white', 'dark:bg-accent-cyan', 'dark:text-navy-950');
                        b.classList.add('bg-slate-200/70', 'text-slate-700', 'dark:bg-navy-900', 'dark:text-slate-300');
                    });
                    btn.classList.remove('bg-slate-200/70', 'text-slate-700', 'dark:bg-navy-900', 'dark:text-slate-300');
                    btn.classList.add('bg-sky-600', 'text-white', 'dark:bg-accent-cyan', 'dark:text-navy-950');

                    // Filter cards
                    projectCards.forEach(card => {
                        const category = card.getAttribute('data-category');
                        if (selected === 'all' || category === selected) {
                            card.classList.remove('hidden');
                        } else {
                            card.classList.add('hidden');
                        }
                    });
                });
            });

            // -----------------------------------------------------------------
            // 6. Project Write-Up Modal Data & Controls
            // -----------------------------------------------------------------
            // REPLACE: Update the githubUrl values below with your actual repository URLs
            const projectWriteUps = {
                'powershell-toolkit': {
                    category: 'Automation // PRJ-01',
                    title: 'PowerShell AD & Endpoint Remediation Toolkit',
                    objective: 'Eliminate repetitive Tier 2/3 administrative toil and enforce Zero Trust identity hygiene across 800+ endpoints by automating bulk Active Directory group updates, stale account audits, and Intune Proactive Remediation registry checks.',
                    stack: ['PowerShell 5.1 / 7', 'Active Directory Module', 'Microsoft Intune Remediations', 'Windows Registry', 'CSV Logging'],
                    implementation: 'Created modular, idempotent scripts with structured error handling and transcript logging. The snippet below pairs a bulk AD RBAC group audit with an Intune detection script that verifies hardened SMBv1/TLS registry compliance.',
                    code: `<#
.SYNOPSIS
    Audits stale Active Directory accounts and checks endpoint registry hardening.
#>
[CmdletBinding()]
param (
    [int]$InactiveDays = 90,
    [string]$ReportPath = ".\\AD_Stale_Accounts_$(Get-Date -Format 'yyyyMMdd').csv"
)

try {
    Import-Module ActiveDirectory -ErrorAction Stop
    $Cutoff = (Get-Date).AddDays(-$InactiveDays)

    $StaleUsers = Get-ADUser -Filter { Enabled -eq $true } -Properties LastLogonDate, Department |
        Where-Object { $_.LastLogonDate -lt $Cutoff -and $_.LastLogonDate -ne $null } |
        Select-Object SamAccountName, Name, Department, LastLogonDate

    $StaleUsers | Export-Csv -Path $ReportPath -NoTypeInformation -Encoding UTF8
    Write-Output "Exported $($StaleUsers.Count) inactive accounts to $ReportPath"

    # Intune Detection Check: Ensure SMBv1 is disabled
    $SmbKey = Get-ItemProperty -Path "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters" -Name "SMB1" -ErrorAction SilentlyContinue
    if ($SmbKey.SMB1 -eq 0) { Write-Output "COMPLIANT: SMBv1 Disabled"; Exit 0 }
    else { Write-Output "NON-COMPLIANT: Remediation Required"; Exit 1 }
}
catch {
    Write-Error "Script execution failed: $($_.Exception.Message)"
    Exit 1
}`,
                    result: 'Reduced recurring weekly AD group/audit tasks from 45+ minutes to under 15 seconds while automating endpoint registry and application remediation across the fleet with zero manual touch.',
                    githubUrl: 'https://github.com/your-github-username/powershell-ad-remediation-toolkit'
                },
                'intune-sccm-lab': {
                    category: 'Endpoint & Infra // PRJ-02',
                    title: 'Enterprise SCCM / Intune Windows 11 Deployment Lab',
                    objective: 'Architect a repeatable, co-managed Windows 11 deployment and application lifecycle pipeline combining MECM/SCCM and Microsoft Intune Autopilot with automated Win32/MSIX packaging and Zero Trust compliance policies.',
                    stack: ['Microsoft Intune (MDM/MAM)', 'MECM / SCCM', 'Windows 11 Enterprise', 'Win32 / MSIX Packaging', 'Entra ID Conditional Access'],
                    implementation: 'Built dynamic Entra ID device groups driven by Autopilot group tags, wrapped enterprise Win32 apps using IntuneWinAppUtil with PowerShell detection rules, and enforced BitLocker + Defender baselines before granting M365 access.',
                    code: `# 1. Package Win32 App for Microsoft Intune Deployment
.\\IntuneWinAppUtil.exe -c "C:\\AppSource\\CiscoSecureClient" \`
    -s "Setup.msi" -o "C:\\IntunePackages" -q

# 2. Enroll Device into Windows Autopilot with Department Group Tag
