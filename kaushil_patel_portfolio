repadmin /replsummary
dcdiag /test:DNS /q`,
                    result: 'Established a zero-risk staging environment for testing GPO hardening, patch Tuesday rollouts, and disaster recovery snapshots—preventing configuration regressions in production.',
                    githubUrl: 'https://github.com/your-github-username/vmware-windows-server-lab'
                }
            };

            const modal = document.getElementById('project-modal');
            const modalBackdrop = document.getElementById('modal-backdrop');
            const closeModalBtn = document.getElementById('close-modal-btn');
            const closeModalFooterBtn = document.getElementById('close-modal-footer-btn');
            const copyCodeBtn = document.getElementById('copy-code-btn');

            function openProjectModal(projectId) {
                const data = projectWriteUps[projectId];
                if (!data || !modal) return;

                document.getElementById('modal-category').textContent = data.category;
                document.getElementById('modal-title').textContent = data.title;
                document.getElementById('modal-objective').textContent = data.objective;
                document.getElementById('modal-implementation').textContent = data.implementation;
                document.getElementById('modal-code').textContent = data.code;
                document.getElementById('modal-result').textContent = data.result;
                document.getElementById('modal-github-link').href = data.githubUrl;

                const stackContainer = document.getElementById('modal-stack');
                stackContainer.innerHTML = '';
                data.stack.forEach(item => {
                    const pill = document.createElement('span');
                    pill.className = 'px-2.5 py-1 rounded-md font-mono text-xs bg-slate-100 dark:bg-navy-950 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800';
                    pill.textContent = item;
                    stackContainer.appendChild(pill);
                });

                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }

            function closeProjectModal() {
                if (!modal) return;
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }

            document.querySelectorAll('.open-modal-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    openProjectModal(btn.getAttribute('data-project-id'));
                });
            });

            if (closeModalBtn) closeModalBtn.addEventListener('click', closeProjectModal);
            if (closeModalFooterBtn) closeModalFooterBtn.addEventListener('click', closeProjectModal);
            if (modalBackdrop) modalBackdrop.addEventListener('click', closeProjectModal);

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
                    closeProjectModal();
                }
            });

            if (copyCodeBtn) {
                copyCodeBtn.addEventListener('click', () => {
                    const codeText = document.getElementById('modal-code')?.textContent || '';
                    copyTextToClipboard(codeText, 'Code snippet copied to clipboard!');
                });
            }

            // -----------------------------------------------------------------
            // 7. Copy Email Button
            // -----------------------------------------------------------------
            const copyEmailBtn = document.getElementById('copy-email-btn');
            if (copyEmailBtn) {
                copyEmailBtn.addEventListener('click', () => {
                    const email = copyEmailBtn.getAttribute('data-email') || 'kaushilpatel1296@gmail.com';
                    copyTextToClipboard(email, `Copied ${email} to clipboard!`);
                });
            }
        });
    </script>
