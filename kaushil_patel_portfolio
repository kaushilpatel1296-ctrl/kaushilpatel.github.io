# 3. Verify BitLocker Protection Post-Provisioning
$Vol = Get-BitLockerVolume -MountPoint "C:"
if ($Vol.ProtectionStatus -ne "On") { Exit 1 }
Write-Output "Compliant: BitLocker Active ($($Vol.EncryptionMethod))"
Exit 0`,
                    result: 'Cut workstation provisioning time from multi-hour manual imaging to a standardized ~25-minute zero-touch deployment with 100% BitLocker compliance and automated patch rings.',
                    githubUrl: 'https://github.com/your-github-username/sccm-intune-win11-lab'
                },
                'forensics-htb': {
                    category: 'Security // PRJ-03',
                    title: 'Active Threat Hunting & Network Forensics — Hack The Box Labs',
                    objective: 'Strengthen blue-team incident response and root-cause analysis by investigating simulated enterprise breaches in Hack The Box defensive labs—correlating PCAP network traffic with Windows Event Logs to reconstruct full attacker timelines.',
                    stack: ['Hack The Box', 'Wireshark / tshark', 'Windows Event Logs (EVTX)', 'PowerShell Get-WinEvent', 'TCP/IP & DNS Analysis'],
                    implementation: 'Combined automated tshark packet extraction with PowerShell EVTX filtering to rapidly isolate anomalous outbound DNS/HTTP C2 beacons, brute-force logon bursts (Event ID 4625), and suspicious PowerShell script blocks (Event ID 4104).',
                    code: `# 1. Extract suspicious HTTP/DNS indicators from a PCAP using tshark
tshark -r incident_capture.pcap -Y "http.request || dns.qry.name" \\
  -T fields -e frame.time_utc -e ip.src -e ip.dst -e http.host -e dns.qry.name

# 2. Hunt for Failed Logons (Event ID 4625) in exported Security.evtx
Get-WinEvent -FilterHashtable @{ Path = '.\\Security.evtx'; Id = 4625 } |
  ForEach-Object {
      [PSCustomObject]@{
          TimeCreated = $_.TimeCreated
          TargetUser  = $_.Properties[5].Value
          SourceIP    = $_.Properties[19].Value
      }
  } | Group-Object SourceIP | Sort-Object Count -Descending | Select-Object -First 5`,
                    result: 'Produced repeatable triage playbooks that pinpoint attacker IOCs, initial access vectors, and lateral movement in minutes—directly supporting enterprise incident response and vulnerability audits.',
                    githubUrl: 'https://github.com/your-github-username/htb-threat-hunting-writeups'
                },
                'vmware-server-lab': {
                    category: 'Endpoint & Infra // PRJ-04',
                    title: 'VMware vSphere & Windows Server Virtualization Lab',
                    objective: 'Build an isolated, production-like enterprise server lab on VMware vSphere/ESXi and Hyper-V to safely validate Active Directory GPO changes, DNS/DHCP failover, and Windows Server security patches prior to rollout.',
                    stack: ['VMware vSphere / ESXi', 'Hyper-V', 'Windows Server', 'Active Directory (GPO/DNS/DHCP)', 'VMware PowerCLI'],
                    implementation: 'Provisioned a segmented VLAN virtual switch hosting redundant Domain Controllers, a member file/app server, and Windows 11 test clients. Automated pre-patch VM snapshots and AD health checks via PowerCLI and PowerShell.',
                    code: `# 1. Automate Pre-Patch Snapshots across Lab VMs using VMware PowerCLI
